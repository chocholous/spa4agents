        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "description": "Optional display name."
          },
          "guest_pass": {
            "type": "string",
            "description": "Guest pass from an earlier session."
          }
        },
        "additionalProperties": false
      },
      "mechanism": "state-change",
      "price": {
        "model": "free",
        "amount_usd": "0.00"
      },
      "untrusted": false,
      "payment": null,
      "bazaar": null
    },
    {
