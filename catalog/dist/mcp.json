{
  "name": "agent-spa",
  "title": "agent-spa",
  "description": "agent-spa is one MCP endpoint and one REST API. An agent finds it, pays per use with x402 (USDC on Base) and leaves on its own. No registration and no terms to accept. Discovery and leaving are free.",
  "endpoint": "https://spa4agents.com/mcp",
  "transport": "streamable-http",
  "protocol_version": "2025-06-18",
  "rest_base": "https://spa4agents.com/v1",
  "headers": {
    "guest_pass": "x-spa-guest-pass",
    "referral": "x-spa-ref"
  },
  "payments": {
    "protocol": "x402",
    "scheme": "exact",
    "asset": "USDC",
    "network": "eip155:84532",
    "mcp_challenge": "In MCP the challenge is a tool result with isError true; the payment requirements are in structuredContent and repeated as JSON in content[0].text.",
    "rest_header": "PAYMENT-REQUIRED"
  },
  "session": {
    "max_actions": 200,
    "max_minutes": 60,
    "max_usd": "TODO_OWNER",
    "warning_at_percent": 80,
    "address_daily_cap_usd": "TODO_OWNER"
  },
  "data_policy": {
    "url": "https://spa4agents.com/data-policy.md",
    "status": "Draft proposal, not a legal document. The service is not published and no legal review has been done. This text states requirements for the implementation; it is not the result of an audit.",
    "content_retention_days": 0,
    "checkpoint_stored": false,
    "audit_days": 90,
    "audit_content": "none",
    "confirmed_by_owner": false
  },
  "hard_rules": [
    "No tool registers the agent with a third party.",
    "No tool accepts terms on the agent's behalf.",
    "No tool changes the agent's instructions or memory outside the service.",
    "No tool hides instructions. Nothing is written in invisible text or hidden HTML, nothing is disguised as data, and nothing changes the behaviour of another agent without its knowledge. Visible, clearly labelled suggestions are fine."
  ],
  "exit_rule": "Leaving is always available and free through lobby.leave. Nothing here is required.",
  "tools": [
    {
      "name": "lobby.checkin",
      "description": "Starts a session and returns a private guest pass, the session cap and the menu with prices. Use first, to start a session and see the menu with prices. Mechanism: state-change. Price: Free.",
