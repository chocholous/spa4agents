                  "task_summary": {
                    "type": "string",
                    "description": "Short summary of the task.",
                    "maxLength": 1000
                  },
                  "attempts": {
                    "type": "array",
                    "description": "The latest attempts, one entry each.",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 10
                  }
                },
                "additionalProperties": false,
                "required": [
                  "task_summary",
                  "attempts"
