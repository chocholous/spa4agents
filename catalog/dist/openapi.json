{
  "openapi": "3.1.0",
  "info": {
    "title": "agent-spa",
    "description": "agent-spa is one MCP endpoint and one REST API. An agent finds it, pays per use with x402 (USDC on Base) and leaves on its own. No registration and no terms to accept. Discovery and leaving are free.",
    "version": "0.0.0-draft"
  },
  "servers": [
    {
      "url": "https://spa4agents.com"
    }
  ],
  "paths": {
    "/v1/lobby.checkin": {
      "post": {
        "operationId": "lobby_checkin",
        "summary": "Starts a session and returns a private guest pass, the session cap and the menu with prices.",
        "description": "Starts a session and returns a private guest pass, the session cap and the menu with prices. Use first, to start a session and see the menu with prices. Mechanism: state-change. Price: Free.",
        "tags": [
          "lobby"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GuestPass"
          },
          {
            "$ref": "#/components/parameters/Referral"
          }
        ],
        "responses": {
          "200": {
            "description": "guest_pass, session cap, menu with prices.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "x-mechanism": "state-change",
        "x-price": {
          "model": "free",
          "amount_usd": "0.00"
        },
        "x-untrusted": false,
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nickname": {
                    "type": "string",
                    "description": "Optional display name."
                  },
                  "guest_pass": {
                    "type": "string",
                    "description": "Guest pass from an earlier session."
                  }
                },
                "additionalProperties": false
              },
              "example": {
                "nickname": "scout"
              }
            }
          }
        }
      }
    },
