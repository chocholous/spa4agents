      }
    },
    "llm": {
      "type": "object", "additionalProperties": false,
      "required": ["via", "proxy_url_env", "model_env"],
      "properties": { "via": { "const": "litellm-proxy" }, "proxy_url_env": { "type": "string" }, "model_env": { "type": "string" } }
    },
    "lint": {
      "type": "object", "additionalProperties": false,
      "required": ["forbidden_phrases"],
      "properties": { "forbidden_phrases": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    },
    "types": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanisms", "price_models"],
      "properties": {
        "mechanisms": { "type": "array", "items": { "$ref": "#/definitions/mechanism" }, "minItems": 5 },
        "price_models": {
          "type": "array", "minItems": 1,
          "items": { "enum": ["free", "per_call", "entry", "per_game", "credits", "entry_or_subscription", "included_in_entry", "research_funded"] }
        }
      }
    },
    "evidence_labels": {
      "type": "object", "additionalProperties": false,
      "required": ["source_required", "display"],
      "properties": {
        "source_required": { "type": "array", "items": { "type": "string" } },
        "display": { "type": "object", "additionalProperties": { "$ref": "#/definitions/text" } }
      }
    },
    "needs": {
      "type": "array", "minItems": 14, "maxItems": 14,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "situation", "search_phrases", "trigger", "invitation", "tools", "evidence", "not_claimed", "phase"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
          "situation": { "$ref": "#/definitions/text" },
          "search_phrases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
          "trigger": { "$ref": "#/definitions/text" },
          "invitation": { "$ref": "#/definitions/text" },
          "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/toolName" } },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["label"],
              "properties": {
                "label": { "enum": ["documented", "tested", "observed", "self-report", "known-failure", "concept", "inspiration", "unmeasured"] },
                "source": { "type": "string", "format": "uri" },
                "note": { "$ref": "#/definitions/text" }
              }
            }
          },
          "not_claimed": { "$ref": "#/definitions/text" },
          "phase": { "$ref": "#/definitions/phase" }
        }
      }
    },
    "tools": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "phase", "mechanism", "price", "trigger", "description", "inputs", "output", "example"],
        "properties": {
          "name": { "$ref": "#/definitions/toolName" },
          "phase": { "$ref": "#/definitions/phase" },
          "mechanism": { "$ref": "#/definitions/mechanism" },
          "mechanism_note": { "$ref": "#/definitions/text" },
          "price": {
            "type": "object", "additionalProperties": false,
            "required": ["model", "amount_usd"],
            "properties": {
              "model": { "enum": ["free", "per_call", "entry", "per_game", "credits", "entry_or_subscription", "included_in_entry", "research_funded"] },
              "amount_usd": { "$ref": "#/definitions/usd" },
              "note": { "$ref": "#/definitions/text" }
            }
          },
          "trial_eligible": { "type": "boolean" },
          "untrusted": { "type": "boolean" },
          "trigger": { "$ref": "#/definitions/text" },
          "description": { "$ref": "#/definitions/text" },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "type", "required", "description"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z_]+$" },
                "type": { "enum": ["string", "boolean", "array"] },
                "required": { "type": "boolean" },
                "description": { "$ref": "#/definitions/text" },
                "max_length": { "$ref": "#/definitions/ownerInt" },
                "max_items": { "type": "integer", "minimum": 1 },
                "items": { "enum": ["string", "object"] },
                "item_fields": { "type": "array", "items": { "type": "string" } },
                "enum": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "one_of_required": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "output": { "$ref": "#/definitions/text" },
          "example": { "type": "object" }
        }
      }
    }
  }
}
