{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mcp.schema.json",
  "title": "Generated mcp.json (/.well-known/mcp.json)",
  "description": "Own schema for the generated discovery file. There is no official schema for this file; it pins the shape the generator promises.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "title", "description", "endpoint", "transport", "protocol_version", "rest_base", "headers", "payments", "session", "data_policy", "hard_rules", "exit_rule", "tools"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https://" },
    "transport": { "const": "streamable-http" },
    "protocol_version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rest_base": { "type": "string", "format": "uri" },
    "headers": { "type": "object", "required": ["guest_pass", "referral"], "additionalProperties": { "type": "string" } },
    "payments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "scheme", "asset", "network", "mcp_challenge", "rest_header"],
      "properties": {
        "protocol": { "const": "x402" }, "scheme": { "type": "string" }, "asset": { "type": "string" },
        "network": { "type": "string", "pattern": "^eip155:\\d+$" }, "mcp_challenge": { "type": "string" }, "rest_header": { "type": "string" }
      }
    },
    "session": { "type": "object" },
    "data_policy": { "type": "object", "required": ["url", "content_retention_days", "checkpoint_stored"], "properties": { "content_retention_days": { "const": 0 }, "checkpoint_stored": { "const": false } } },
    "hard_rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "exit_rule": { "type": "string" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "inputSchema", "mechanism", "price", "untrusted", "payment", "bazaar"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$" },
          "description": { "type": "string", "minLength": 1 },
          "inputSchema": { "type": "object", "required": ["type", "properties"], "properties": { "type": { "const": "object" }, "properties": { "type": "object" } } },
          "mechanism": { "type": "string" },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "amount_usd", "status"],
            "properties": {
              "model": { "type": "string" },
              "amount_usd": { "type": ["string", "null"], "pattern": "^\\d+(\\.\\d+)?$" },
              "status": { "enum": ["free", "included", "pending", "set"] }
            }
          },
          "untrusted": { "type": "boolean" },
          "payment": { "type": ["object", "null"] },
          "bazaar": { "type": ["object", "null"] }
        }
      }
    }
  }
}
