{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "server.schema.json",
  "title": "Generated server.json (MCP Registry), offline subset",
  "description": "Offline subset of the MCP Registry server.json schema (2025-09-29): the fields the generator writes, with the registry's constraints. The official schema is not fetched in tests (no network). The only deviation: the namespace may be the placeholder TODO_OWNER while the owner has not chosen one (catalog question A8); the registry would reject it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "description", "version", "remotes"],
  "properties": {
    "$schema": { "type": "string", "pattern": "^https://static\\.modelcontextprotocol\\.io/schemas/\\d{4}-\\d{2}-\\d{2}/server\\.schema\\.json$" },
    "name": { "type": "string", "minLength": 3, "maxLength": 200, "pattern": "^([a-zA-Z0-9.-]+|TODO_OWNER)/[a-zA-Z0-9._-]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "minLength": 1, "maxLength": 255, "not": { "const": "latest" } },
    "websiteUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "remotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "url"],
        "additionalProperties": false,
        "properties": { "type": { "enum": ["streamable-http", "sse"] }, "url": { "type": "string", "format": "uri", "pattern": "^https://" } }
      }
    },
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "type": "object",
          "properties": {
            "pricing": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "currency", "tools"],
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "currency": { "type": "string" },
                "tools": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "price_status", "amount_usd"],
                    "properties": { "name": { "type": "string" }, "price_status": { "enum": ["free", "included", "pending", "set"] }, "amount_usd": { "type": ["string", "null"] } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
