# Zkopírujte na deploy/.env a doplňte. Skutečné hodnoty NIKDY do gitu.

# --- Přepínač IP / doména ---
# ip     = HTTP na portu 80 podle IP (jen testy), domain = automatické TLS
SITE_MODE=ip
# Používá se jen při SITE_MODE=domain
SITE_ADDRESS=spagents.com

# --- Gateway ---
# Veřejná základní URL (IP režim: http://<IP>, doménový: https://spagents.com)
BASE_URL=
PORT=8787
GATEWAY_PHASES=F1

# --- x402 platby (gateway je dnes ještě nečte; připraveno) ---
# Adresa příjemce (veřejná), např. z scripts/make-testnet-wallet.mjs
PAY_TO_ADDRESS=
# Base Sepolia (testnet). Mainnet až po rozhodnutí vlastníka: eip155:8453
X402_NETWORK=eip155:84532
# URL facilitátoru – doplnit podle aktuální dokumentace
X402_FACILITATOR_URL=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Relace ---
SESSION_MAX_ACTIONS=200
SESSION_MAX_MINUTES=60
SESSION_MAX_USD=

# --- Trial ---
TRIAL_FREE_SESSIONS=3
TRIAL_MAX_TURNS_PER_SESSION=20
