# Spagents gateway: konfigurace přes env. Tento soubor neobsahuje žádné klíče; skutečné hodnoty patří jen do prostředí
# (secrets hostingu), nikdy do repozitáře.

# --- Server ---
PORT=8787
HOST=127.0.0.1
# Veřejná adresa (https://spagents.com). Nepovinné: bez ní se výzva odvozuje z hlavičky Host, takže to funguje na IP/localhostu.
BASE_URL=
# Kolik reverzních proxy je před serverem (X-Forwarded-For se bere zprava). 0 = bere se adresa spojení.
TRUST_PROXY_HOPS=0
# Katalog (jediný zdroj pravdy) a text pro initialize.instructions (generovaný z katalogu).
# CATALOG_PATH=../catalog/catalog.yaml
# INSTRUCTIONS_PATH=../catalog/dist/initialize-instructions.txt

# --- Platby x402 ---
# Příjmová adresa (veřejná adresa, ne soukromý klíč). Povinné.
PAY_TO_ADDRESS=
# Síť: eip155:84532 = Base Sepolia (testnet), eip155:8453 = Base (hlavní síť).
X402_NETWORK=eip155:84532
# Facilitátor: "url" (výchozí) použije X402_FACILITATOR_URL; "cdp" použije Coinbase CDP s klíči níže.
X402_FACILITATOR=url
X402_FACILITATOR_URL=https://x402.org/facilitator
# Jen pro X402_FACILITATOR=cdp (hodnoty dodá vlastník přes secrets, nikdy do repozitáře).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Relace a stropy (defaulty jsou z katalogu: 200 akcí, 60 minut, 0.50 USD, 5 USD na adresu a den) ---
# SESSION_MAX_ACTIONS=200
# SESSION_MAX_MINUTES=60
# SESSION_MAX_USD=0.50
# SESSION_ADDRESS_DAILY_MAX_USD=5.00
# SESSION_WARN_PERCENT=80
# Nečinnost, po které se relace zahodí z paměti.
# SESSION_IDLE_MINUTES=30
# SESSION_MAX_LIVE=20000
# MAX_BODY_BYTES=65536

# --- Zkušební pobyt (trial; defaulty z katalogu) ---
# TRIAL_FREE_SESSIONS=3
# TRIAL_MAX_TURNS_PER_SESSION=20
# TRIAL_VALID_DAYS=14
# TRIAL_DAILY_BUDGET_USD=20.00
# TRIAL_PER_ADDRESS_PER_DAY=1
# TRIAL_PER_IP_PER_DAY=1

# --- Pozvánky (defaulty z katalogu) ---
# REFERRAL_INVITEE_DISCOUNT_PERCENT=10
# REFERRAL_INVITEE_FREE_CALLS=3
# REFERRAL_CREDIT_PERCENT=20
# REFERRAL_CREDIT_DAYS=30
# REFERRAL_CREDIT_MONTHLY_CAP_USD=20.00
# REFERRAL_SELF_EARNS=false

# --- Ostatní ---
# GATEWAY_PHASES=F1
# TIMEOUT_MS_TEXT=5000
# PAUSE_RETRY_AFTER_SECONDS=30
